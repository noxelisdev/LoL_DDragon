ico</physicalDamage> según la distancia que Hecarim recorra durante <spellName>Carga devastadora</spellName>.{{ spellmodifierdescriptionappend }}","leveltip":{"label":["Daño mínimo","Daño máximo","Enfriamiento"],"effect":["{{ minbasedamage }} -> {{ minbasedamageNL }}","{{ maxbasedamage }} -> {{ maxbasedamageNL }}","{{ cooldown }} -> {{ cooldownNL }}"]},"maxrank":5,"cooldown":[24,22,20,18,16],"cooldownBurn":"24/22/20/18/16","cost":[60,60,60,60,60],"costBurn":"60","datavalues":{},"effect":[null,[300,300,300,300,300],[300,300,300,300,300],[80,150,220,290,360],[40,75,110,145,180],[4,4,4,4,4],[0.75,0.75,0.75,0.75,0.75],[1200,1200,1200,1200,1200],[0.25,0.25,0.25,0.25,0.25],[2.5,2.5,2.5,2.5,2.5],[0,0,0,0,0]],"effectBurn":[null,"300","300","80/150/220/290/360","40/75/110/145/180","4","0.75","1200","0.25","2.5","0"],"vars":[],"costType":" {{ abilityresourcename }}","maxammo":"-1","range":[300,300,300,300,300],"rangeBurn":"300","image":{"full":"Jade_HecarimE.png","sprite":"spell2.png","group":"spell","x":192,"y":144,"w":48,"h":48},"resource":"{{ cost }} {{ abilityresourcename }}"},{"id":"Jade_HecarimR","name":"Envite de sombras","description":"Hecarim invoca jinetes espectrales y carga hacia delante, lo que inflige daño mágico en línea recta. Hecarim crea una onda de choque al terminar su carga que hace que los enemigos cercanos huyan aterrorizados.","tooltip":"Hecarim invoca jinetes espectrales y carga hacia delante, lo que inflige <magicDamage>{{ totaldamage }} de daño mágico</magicDamage> a los enemigos golpeados.<br /><br />Hecarim crea una onda de choque al terminar su carga que <status>aterroriza</status> a los enemigos cercanos durante {{ fearduration }} s.{{ spellmodifierdescriptionappend }}","leveltip":{"label":["Daño","Enfriamiento"],"effect":["{{ basedamage }} -> {{ basedamageNL }}","{{ cooldown }} -> {{ cooldownNL }}"]},"maxrank":3,"cooldown":[140,120,100],"cooldownBurn":"140/120/100","cost":[100,100,100],"costBurn":"100","datavalues":{},"effect":[null,[150,250,35